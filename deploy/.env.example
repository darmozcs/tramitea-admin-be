APP_IMAGE=ghcr.io/darmozcs/tramitea-admin-be:latest

# La MISMA base y credenciales que tramitea-be (/opt/infra/services/tramitea-be/.env).
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/nexora
SPRING_DATASOURCE_USERNAME=nexora
SPRING_DATASOURCE_PASSWORD=<password de postgres>

# darmoz-auth por la red interna (incluye su context path /auth).
DARMOZ_AUTH_URL=http://darmoz-auth:8080/auth
DARMOZ_AUTH_PUBLIC_KEY_PATH=/app/keys/darmoz_public_key.pem
# UUID de la Application "Tramitea" en darmoz-auth (el mismo de tramitea-be).
DARMOZ_AUTH_APPLICATION_ID=<api-id de Tramitea en darmoz-auth>
# Rol de esa Application que habilita el admin.
ADMIN_ROLE=ADMIN
